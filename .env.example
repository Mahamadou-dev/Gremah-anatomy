# Gremah Anatomy — variables d'environnement
#
# Copiez ce fichier en `.env.local` pour le développement. En production, les
# mêmes clés se renseignent dans les réglages du projet Vercel.
#
# `.env.local` est ignoré par git : il ne doit jamais être commité.

# --- Comptes étudiants (obligatoire pour /connexion, /inscription, /atlas) ---

# Chaîne de connexion du cluster MongoDB Atlas.
# Atlas → Database → Connect → Drivers → Node.js.
# Pensez à autoriser les adresses IP de Vercel dans Network Access (0.0.0.0/0
# si vous n'utilisez pas d'IP statique — c'est le mot de passe qui protège,
# pas le filtrage IP).
MONGODB_URI="mongodb+srv://utilisateur:motdepasse@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority"

# Nom de la base. Par défaut : gremah_anatomy
MONGODB_DB="gremah_anatomy"

# Clé de signature des cookies de session. 32 caractères minimum.
# Générez-la avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# La changer déconnecte tout le monde — ce qui est exactement ce qu'on veut
# faire si on la soupçonne d'avoir fuité.
AUTH_SECRET=""

# --- Envoi d'emails · Sprint 13 (pas encore utilisé) -------------------------

# Décision du Sprint 13 : SMTP Gmail, sans service tiers ni domaine à vérifier.
# L'expéditeur est l'adresse déjà publiée dans le pied de page, donc l'étudiant
# reconnaît qui lui écrit.
#
# Le mot de passe n'est PAS celui du compte Google : il faut un « mot de passe
# d'application », qui suppose la validation en deux étapes activée.
#   1. https://myaccount.google.com/security → Validation en deux étapes
#   2. https://myaccount.google.com/apppasswords → nommer la clé, la copier
#      immédiatement (Google ne la réaffiche jamais)
#
# Ce secret ouvre la boîte d'envoi : jamais dans le dépôt, jamais sous un
# préfixe NEXT_PUBLIC_ (qui inline la valeur dans le bundle du navigateur).
# Plafond du compte gratuit : 500 messages par jour.
# GMAIL_UTILISATEUR="mahamadou8877@gmail.com"
# GMAIL_MOT_DE_PASSE_APP="xxxxxxxxxxxxxxxx"

# --- Formulaire de contact (facultatif) --------------------------------------

# Sans cette variable, le formulaire ouvre le client mail du visiteur avec un
# message pré-rempli — aucun tiers impliqué, rien qui puisse tomber en panne.
# Avec elle, le message part directement par POST JSON (Formspree, Web3Forms…).
# NEXT_PUBLIC_CONTACT_ENDPOINT="https://formspree.io/f/xxxxxxxx"

# --- Métadonnées (facultatif) ------------------------------------------------

# URL absolue du site, pour og:image et le JSON-LD. Déduite de Vercel sinon.
# NEXT_PUBLIC_SITE_URL="https://gremah-anatomy.vercel.app"
